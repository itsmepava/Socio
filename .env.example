# Copy to .env and set a long, random value before running locally.
SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=sqlite:///membership.db
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
# Show the platform-admin shortcut during local development. Set to 0 for a public deployment.
# The local setup script enables this development shortcut. Keep it off on hosted environments.
SHOW_PLATFORM_ADMIN_LINK=0

# Local-only email preview: confirmation links are printed in the Flask server console.
# This requires PUBLIC_BASE_URL to be localhost and must not be enabled on a public server.
DEV_EMAIL_PREVIEW=1
PUBLIC_BASE_URL=http://127.0.0.1:5000

# For real email delivery, turn DEV_EMAIL_PREVIEW off and set your provider's SMTP values.
# MAIL_SERVER=smtp.your-provider.example
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM=Socio <noreply@your-domain.example>
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
